        <mxCell id="desc_overview" parent="desc_panel" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" value="The U.S. Embassy in Rome unifies SMART cable archives with Salesforce CRM and policy documents through the Snowflake AI Data Cloud, enabling AI-powered diplomatic intelligence governed by Horizon security controls." vertex="1">
          <mxGeometry height="35" width="1020" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_1" parent="desc_panel" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;1. Ingest&lt;/b&gt; -- SMART cables, Salesforce CRM contacts/activities, and policy/intel documents are ingested into Snowflake via hybrid batch archive and near-real-time API sync." vertex="1">
          <mxGeometry height="25" width="1020" x="20" y="85" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_2" parent="desc_panel" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;2. Land&lt;/b&gt; -- Raw data lands in Bronze layer tables preserving full fidelity of source records (CRM contacts, activity logs, sector intelligence, cables)." vertex="1">
          <mxGeometry height="25" width="1020" x="20" y="112" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_3" parent="desc_panel" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;3. Model&lt;/b&gt; -- Gold layer presents a unified Semantic View across CRM, cables, and policy data with governed analytical access and defined metrics." vertex="1">
          <mxGeometry height="25" width="1020" x="20" y="139" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_4" parent="desc_panel" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;4. Enrich&lt;/b&gt; -- Cortex Search indexes policy documents and sector intelligence for semantic retrieval; Cortex Complete (mistral-large2) performs LLM-powered analysis." vertex="1">
          <mxGeometry height="25" width="1020" x="20" y="166" as="geometry" />
        </mxCell>
        <mxCell id="desc_step_5" parent="desc_panel" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;5. Orchestrate&lt;/b&gt; -- Cortex Agent combines text-to-SQL (via Semantic View) with Cortex Search tools for multi-step diplomatic intelligence queries." vertex="1">
          <mxGeometry height="25" width="1020" x="20" y="193" as="geometry" />
        </mxCell>
